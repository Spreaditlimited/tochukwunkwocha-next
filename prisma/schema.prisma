model TochukwuFinancialTransaction {
  id                  BigInt    @id @default(autoincrement())
  transactionUuid     String    @unique(map: "uniq_tochukwu_financial_transaction_uuid") @map("transaction_uuid") @db.VarChar(100)
  sourceType          String    @map("source_type") @db.VarChar(40)
  sourceUuid          String    @map("source_uuid") @db.VarChar(100)
  sourceParentUuid    String?   @map("source_parent_uuid") @db.VarChar(100)
  category            String    @db.VarChar(30)
  paymentType         String    @map("payment_type") @db.VarChar(50)
  productSlug         String?   @map("product_slug") @db.VarChar(190)
  productLabel        String    @map("product_label") @db.VarChar(255)
  customerName        String?   @map("customer_name") @db.VarChar(190)
  customerEmail       String?   @map("customer_email") @db.VarChar(220)
  currency            String    @db.VarChar(12)
  salesAmountMinor    BigInt    @default(0) @map("sales_amount_minor")
  discountMinor       BigInt    @default(0) @map("discount_minor")
  vatMinor            BigInt    @default(0) @map("vat_minor")
  processingFeeMinor  BigInt    @default(0) @map("processing_fee_minor")
  shippingMinor       BigInt    @default(0) @map("shipping_minor")
  totalCollectedMinor BigInt    @default(0) @map("total_collected_minor")
  provider            String?   @db.VarChar(40)
  paymentReference    String?   @map("payment_reference") @db.VarChar(190)
  paidAt              DateTime  @map("paid_at") @db.DateTime(0)
  sourceCreatedAt     DateTime? @map("source_created_at") @db.DateTime(0)
  breakdownQuality    String    @default("exact") @map("breakdown_quality") @db.VarChar(20)
  metadataJson        String?   @map("metadata_json") @db.LongText
  createdAt           DateTime  @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @map("updated_at") @db.DateTime(0)

  @@unique([sourceType, sourceUuid], map: "uniq_tochukwu_financial_source")
  @@index([paidAt], map: "idx_tochukwu_financial_paid_at")
  @@index([category, paidAt], map: "idx_tochukwu_financial_category_paid")
  @@index([currency, paidAt], map: "idx_tochukwu_financial_currency_paid")
  @@index([productSlug, paidAt], map: "idx_tochukwu_financial_product_paid")
  @@index([provider, paidAt], map: "idx_tochukwu_financial_provider_paid")
  @@map("tochukwu_financial_transactions")
}

model TochukwuFinancialExportAudit {
  id          BigInt   @id @default(autoincrement())
