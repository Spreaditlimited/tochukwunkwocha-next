generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TochukwuBlogPost {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  pidBlog       String   @unique(map: "uniq_tochukwu_blog_pid") @map("pid_blog") @db.VarChar(64)
  blogTitle     String   @map("blog_title") @db.VarChar(255)
  blogContent   String?  @map("blog_content") @db.LongText
  blogSlug      String   @unique(map: "uniq_tochukwu_blog_slug") @map("blog_slug") @db.VarChar(255)
  blogPublished Boolean  @default(false) @map("blog_published")
  blogFeatured  Boolean  @default(false) @map("blog_featured")
  blogImage     String?  @map("blog_image") @db.VarChar(500)
  blogBy        String?  @map("blog_by") @db.VarChar(120)
  blogExt1      String?  @map("blog_ext1") @db.VarChar(700)
  blogExt2      String?  @map("blog_ext2") @db.LongText
  excerpt       String?  @db.Text
  tagsJson      String?  @map("tags_json") @db.Text
  seoJson       String?  @map("seo_json") @db.LongText
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  leadMagnet       TochukwuBlogLeadMagnet?
  seoOpportunities TochukwuSeoOpportunity[]
  seoChanges       TochukwuSeoContentChangeLog[]

  @@index([blogPublished, createdAt], map: "idx_tochukwu_blog_status_created")
  @@index([blogFeatured, createdAt], map: "idx_tochukwu_blog_featured")
  @@map("tochukwu_blog_posts")
}

model TochukwuAdminAccount {
  id           BigInt    @id @default(autoincrement())
  adminUuid    String    @unique(map: "uniq_tochukwu_admin_uuid") @map("admin_uuid") @db.VarChar(64)
  fullName     String    @map("full_name") @db.VarChar(180)
  email        String    @unique(map: "uniq_tochukwu_admin_email") @db.VarChar(220)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  passwordSalt String    @map("password_salt") @db.VarChar(255)
  isOwner      Boolean   @default(false) @map("is_owner")
  isActive     Boolean   @default(true) @map("is_active")
  allowedPages String?   @map("allowed_pages") @db.Text
  createdBy    String?   @map("created_by") @db.VarChar(120)
  createdAt    DateTime  @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @map("updated_at") @db.DateTime(0)
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(0)

  @@index([isActive, email], map: "idx_tochukwu_admin_active")
  @@map("tochukwu_admin_accounts")
}

model TochukwuBlogLeadMagnet {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  magnetUuid      String   @unique(map: "uniq_blog_lead_magnet_uuid") @map("magnet_uuid") @db.VarChar(80)
  pidBlog         String   @unique(map: "uniq_blog_lead_magnet_pid") @map("pid_blog") @db.VarChar(64)
  slug            String   @unique(map: "uniq_blog_lead_magnet_slug") @db.VarChar(255)
  status          String   @default("inactive") @db.VarChar(32)
  title           String   @db.VarChar(255)
  offerHeadline   String?  @map("offer_headline") @db.VarChar(255)
  description     String?  @db.Text
  buttonText      String?  @map("button_text") @db.VarChar(120)
  bulletsJson     String?  @map("bullets_json") @db.Text
  pdfUrl          String?  @map("pdf_url") @db.Text
  pdfPublicId     String?  @map("pdf_public_id") @db.VarChar(500)
  pdfResourceType String?  @map("pdf_resource_type") @db.VarChar(40)
  pdfFilename     String?  @map("pdf_filename") @db.VarChar(255)
  brevoListId     BigInt?  @map("brevo_list_id")
  emailSubject    String?  @map("email_subject") @db.VarChar(255)
  deliveryMessage String?  @map("delivery_message") @db.Text
  createdAt       DateTime @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @map("updated_at") @db.DateTime(0)

  blog TochukwuBlogPost @relation(fields: [pidBlog], references: [pidBlog])

  @@index([status], map: "idx_blog_lead_magnet_status")
  @@index([pidBlog, status], map: "idx_blog_lead_magnet_pid_status")
  @@map("tochukwu_blog_lead_magnets")
}

model TochukwuSearchConsoleImportRun {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  runUuid         String    @unique(map: "uniq_tochukwu_sc_run_uuid") @map("run_uuid") @db.VarChar(80)
  source          String    @default("manual") @db.VarChar(40)
  siteUrl         String    @default("") @map("site_url") @db.VarChar(255)
  dimensions      String    @default("date,page,query,country,device") @db.VarChar(255)
  status          String    @default("pending") @db.VarChar(32)
  startedAt       DateTime  @default(now()) @map("started_at") @db.DateTime(0)
  completedAt     DateTime? @map("completed_at") @db.DateTime(0)
  sourceStartDate DateTime? @map("source_start_date") @db.Date
  sourceEndDate   DateTime? @map("source_end_date") @db.Date
  rowCount        Int       @default(0) @map("row_count")
  errorMessage    String?   @map("error_message") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.DateTime(0)

  queryStats TochukwuSearchConsoleQueryStat[]

  @@index([status, completedAt], map: "idx_tochukwu_sc_run_status")
  @@map("tochukwu_search_console_import_runs")
}

model TochukwuSearchConsoleQueryStat {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  statUuid    String    @unique(map: "uniq_tochukwu_sc_stat_uuid") @map("stat_uuid") @db.VarChar(80)
  dedupeKey   String?   @unique(map: "uniq_tochukwu_sc_stat_dedupe") @map("dedupe_key") @db.Char(64)
  runUuid     String    @map("run_uuid") @db.VarChar(80)
  date        DateTime? @db.Date
  siteUrl     String?   @map("site_url") @db.VarChar(255)
  pageUrl     String    @map("page_url") @db.Text
  blogSlug    String?   @map("blog_slug") @db.VarChar(255)
  query       String    @db.VarChar(700)
  country     String?   @db.VarChar(20)
  device      String?   @db.VarChar(40)
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Decimal   @default(0) @db.Decimal(12, 8)
  position    Decimal   @default(0) @db.Decimal(12, 4)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  run TochukwuSearchConsoleImportRun @relation(fields: [runUuid], references: [runUuid])

  @@index([blogSlug], map: "idx_tochukwu_sc_stat_blog_slug")
  @@index([query], map: "idx_tochukwu_sc_stat_query")
  @@index([impressions, position], map: "idx_tochukwu_sc_stat_perf")
  @@index([date], map: "idx_tochukwu_sc_stat_date")
  @@map("tochukwu_search_console_query_stats")
}

model TochukwuSeoOpportunity {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pidOpportunity  String    @unique(map: "uniq_tochukwu_seo_opp_pid") @map("pid_opportunity") @db.VarChar(90)
  pageUrl         String    @map("page_url") @db.Text
  blogSlug        String?   @map("blog_slug") @db.VarChar(255)
  pidBlog         String?   @map("pid_blog") @db.VarChar(64)
  opportunityType String    @map("opportunity_type") @db.VarChar(40)
  primaryQuery    String?   @map("primary_query") @db.VarChar(700)
  queryCluster    String?   @map("query_cluster") @db.LongText
  clicks          Int       @default(0)
  impressions     Int       @default(0)
  ctr             Decimal   @default(0) @db.Decimal(12, 8)
  position        Decimal   @default(0) @db.Decimal(12, 4)
  confidence      Decimal   @default(0) @db.Decimal(10, 4)
  status          String    @default("open") @db.VarChar(32)
  recommendation  String?   @db.Text
  recommendedCta  String?   @map("recommended_cta") @db.VarChar(80)
  sourceStartDate DateTime? @map("source_start_date") @db.Date
  sourceEndDate   DateTime? @map("source_end_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.DateTime(0)

  blog    TochukwuBlogPost?             @relation(fields: [pidBlog], references: [pidBlog])
  changes TochukwuSeoContentChangeLog[]

  @@index([status, confidence], map: "idx_tochukwu_seo_opp_status")
  @@index([blogSlug], map: "idx_tochukwu_seo_opp_blog_slug")
  @@index([blogSlug, status], map: "idx_tochukwu_seo_opp_blog_status")
  @@index([opportunityType], map: "idx_tochukwu_seo_opp_type")
  @@map("tochukwu_seo_opportunities")
}

model TochukwuSeoContentChangeLog {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pidChange      String    @unique(map: "uniq_tochukwu_seo_change_pid") @map("pid_change") @db.VarChar(90)
  pidOpportunity String?   @map("pid_opportunity") @db.VarChar(90)
  pidBlog        String?   @map("pid_blog") @db.VarChar(64)
  changeType     String    @map("change_type") @db.VarChar(50)
  status         String    @default("draft") @db.VarChar(32)
  beforeJson     String?   @map("before_json") @db.LongText
  afterJson      String?   @map("after_json") @db.LongText
  validationJson String?   @map("validation_json") @db.LongText
  publishedAt    DateTime? @map("published_at") @db.DateTime(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.DateTime(0)

  opportunity TochukwuSeoOpportunity? @relation(fields: [pidOpportunity], references: [pidOpportunity])
  blog        TochukwuBlogPost?       @relation(fields: [pidBlog], references: [pidBlog])

  @@index([pidOpportunity, createdAt], map: "idx_tochukwu_seo_change_opp")
  @@index([pidBlog, createdAt], map: "idx_tochukwu_seo_change_blog")
  @@index([status, createdAt], map: "idx_tochukwu_seo_change_status")
  @@map("tochukwu_seo_content_change_logs")
}

model TochukwuSeoLinkablePage {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pidLink       String    @unique(map: "uniq_tochukwu_seo_link_pid") @map("pid_link") @db.VarChar(80)
  url           String    @db.VarChar(1000)
  normalizedUrl String    @unique(map: "uniq_tochukwu_seo_link_url") @map("normalized_url") @db.VarChar(500)
  label         String    @db.VarChar(180)
  status        String    @default("active") @db.VarChar(40)
  source        String    @default("admin") @db.VarChar(40)
  approvedBy    String?   @map("approved_by") @db.VarChar(80)
  approvedAt    DateTime? @map("approved_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @map("updated_at") @db.DateTime(3)

  @@index([status], map: "idx_tochukwu_seo_link_status")
  @@map("tochukwu_seo_linkable_pages")
}

model TochukwuSeoRewriteArtifact {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pidArtifact             String    @unique(map: "uniq_tochukwu_seo_artifact_pid") @map("pid_artifact") @db.VarChar(80)
  pidChange               String    @unique(map: "uniq_tochukwu_seo_artifact_change") @map("pid_change") @db.VarChar(90)
  sourceContentHash       String    @map("source_content_hash") @db.Char(64)
  rewrittenHtml           String?   @map("rewritten_html") @db.LongText
  appliedChangesJson      String?   @map("applied_changes_json") @db.LongText
  discoveredLinksJson     String?   @map("discovered_links_json") @db.LongText
  pendingLinksJson        String?   @map("pending_links_json") @db.LongText
  decisionsJson           String?   @map("decisions_json") @db.LongText
  externalLinkChangesJson String?   @map("external_link_changes_json") @db.LongText
  qualityPolicyVersion    String?   @map("quality_policy_version") @db.VarChar(100)
  openAiResponseId        String?   @map("openai_response_id") @db.VarChar(100)
  openAiResponseStatus    String?   @map("openai_response_status") @db.VarChar(40)
  openAiModel             String?   @map("openai_model") @db.VarChar(80)
  status                  String    @default("rewriting") @db.VarChar(40)
  errorCode               String?   @map("error_code") @db.VarChar(80)
  errorMessage            String?   @map("error_message") @db.Text
  attemptCount            Int       @default(0) @map("attempt_count")
  generatedAt             DateTime? @map("generated_at") @db.DateTime(3)
  reviewedAt              DateTime? @map("reviewed_at") @db.DateTime(3)
  appliedAt               DateTime? @map("applied_at") @db.DateTime(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime  @map("updated_at") @db.DateTime(3)

  @@index([status], map: "idx_tochukwu_seo_artifact_status")
  @@map("tochukwu_seo_rewrite_artifacts")
}

model TochukwuSeoPipelineAttempt {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  pidAttempt   String    @unique(map: "uniq_tochukwu_seo_attempt_pid") @map("pid_attempt") @db.VarChar(80)
  pidChange    String    @map("pid_change") @db.VarChar(90)
  stage        String    @db.VarChar(40)
  status       String    @default("started") @db.VarChar(40)
  errorCode    String?   @map("error_code") @db.VarChar(80)
  errorMessage String?   @map("error_message") @db.Text
  detailsJson  String?   @map("details_json") @db.LongText
  startedAt    DateTime  @default(now()) @map("started_at") @db.DateTime(3)
  completedAt  DateTime? @map("completed_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @map("updated_at") @db.DateTime(3)

  @@index([pidChange, stage], map: "idx_tochukwu_seo_attempt_change_stage")
  @@index([status], map: "idx_tochukwu_seo_attempt_status")
  @@map("tochukwu_seo_pipeline_attempts")
}

model StudentAccount {
  id                         BigInt    @id @default(autoincrement())
  accountUuid                String    @unique(map: "uniq_student_account_uuid") @map("account_uuid") @db.VarChar(64)
  fullName                   String    @map("full_name") @db.VarChar(180)
  email                      String    @unique(map: "uniq_student_account_email") @db.VarChar(190)
  passwordHash               String    @map("password_hash") @db.VarChar(255)
  passwordSalt               String    @map("password_salt") @db.VarChar(255)
  mustResetPassword          Boolean   @default(false) @map("must_reset_password")
  domainsAutoRenewEnabled    Boolean   @default(true) @map("domains_auto_renew_enabled")
  phoneE164                  String?   @map("phone_e164") @db.VarChar(20)
  profilePictureUrl          String?   @map("profile_picture_url") @db.Text
  profilePicturePublicId     String?   @map("profile_picture_public_id") @db.VarChar(500)
  profilePictureUpdatedAt    DateTime? @map("profile_picture_updated_at") @db.DateTime(0)
  whatsappOptedIn            Boolean   @default(false) @map("whatsapp_opted_in")
  whatsappOptedInAt          DateTime? @map("whatsapp_opted_in_at") @db.DateTime(0)
  whatsappOptedOutAt         DateTime? @map("whatsapp_opted_out_at") @db.DateTime(0)
  certificateNameConfirmedAt DateTime? @map("certificate_name_confirmed_at") @db.DateTime(0)
  certificateNameUpdatedAt   DateTime? @map("certificate_name_updated_at") @db.DateTime(0)
  resetTokenHash             String?   @map("reset_token_hash") @db.VarChar(128)
  resetTokenExpiresAt        DateTime? @map("reset_token_expires_at") @db.DateTime(0)
  resetRequestedAt           DateTime? @map("reset_requested_at") @db.DateTime(0)
  createdAt                  DateTime  @map("created_at") @db.DateTime(0)
  updatedAt                  DateTime  @map("updated_at") @db.DateTime(0)
  lastLoginAt                DateTime? @map("last_login_at") @db.DateTime(0)
  publicProjectLearnerType   String?   @map("public_project_learner_type") @db.VarChar(24)

  sessions   StudentSession[]
  shopOrders ShopOrder[]
  publicProfile StudentPublicProfile?
  hireEnquiries StudentHireEnquiry[]

  @@map("student_accounts")
}

model StudentPublicProfile {
  id                       BigInt    @id @default(autoincrement())
  profileUuid              String    @unique(map: "uniq_student_public_profiles_uuid") @map("profile_uuid") @db.VarChar(64)
  accountId                BigInt    @unique(map: "uniq_student_public_profiles_account") @map("account_id")
  publicSlug               String    @unique(map: "uniq_student_public_profiles_slug") @map("public_slug") @db.VarChar(190)
  displayName              String    @map("display_name") @db.VarChar(180)
  professionalHeadline     String?   @map("professional_headline") @db.VarChar(220)
  biography                String?   @db.Text
  country                  String?   @db.VarChar(120)
  skillsJson               String?   @map("skills_json") @db.Text
  featuredProjectSummary   String?   @map("featured_project_summary") @db.Text
  projectChallenge         String?   @map("project_challenge") @db.Text
  projectSolution          String?   @map("project_solution") @db.Text
  projectLearning          String?   @map("project_learning") @db.Text
  opportunityTypesJson     String?   @map("opportunity_types_json") @db.Text
  publicProfileConsent     Boolean   @default(false) @map("public_profile_consent")
  profilePictureConsent    Boolean   @default(false) @map("profile_picture_consent")
  guardianConsentConfirmed Boolean   @default(false) @map("guardian_consent_confirmed")
  openToWork               Boolean   @default(false) @map("open_to_work")
  isPublic                 Boolean   @default(false) @map("is_public")
  reviewStatus             String    @default("pending") @map("review_status") @db.VarChar(24)
  reviewNote               String?   @map("review_note") @db.Text
  reviewedBy               String?   @map("reviewed_by") @db.VarChar(180)
  reviewedAt               DateTime? @map("reviewed_at") @db.DateTime(0)
  publishedSnapshotJson    String?   @map("published_snapshot_json") @db.LongText
  publishedAt              DateTime? @map("published_at") @db.DateTime(0)
  createdAt                DateTime  @map("created_at") @db.DateTime(0)
  updatedAt                DateTime  @map("updated_at") @db.DateTime(0)

  account       StudentAccount       @relation(fields: [accountId], references: [id])
  hireEnquiries StudentHireEnquiry[]

  @@index([reviewStatus, updatedAt], map: "idx_student_public_profiles_review")
  @@index([isPublic, publishedAt], map: "idx_student_public_profiles_public")
  @@map("student_public_profiles")
}

model StudentHireEnquiry {
  id              BigInt   @id @default(autoincrement())
  enquiryUuid     String   @unique(map: "uniq_student_hire_enquiries_uuid") @map("enquiry_uuid") @db.VarChar(64)
  profileId       BigInt   @map("profile_id")
  accountId       BigInt   @map("account_id")
  enquirerName    String   @map("enquirer_name") @db.VarChar(180)
  organisation    String?  @db.VarChar(220)
  enquirerEmail   String   @map("enquirer_email") @db.VarChar(190)
  opportunityType String   @map("opportunity_type") @db.VarChar(60)
  timeline        String?  @db.VarChar(120)
  budgetRange     String?  @map("budget_range") @db.VarChar(120)
  message         String   @db.Text
  status          String   @default("new") @db.VarChar(32)
  deliveryStatus  String   @default("pending") @map("delivery_status") @db.VarChar(32)
  deliveryError   String?  @map("delivery_error") @db.Text
  adminNote       String?  @map("admin_note") @db.Text
  ipHash          String?  @map("ip_hash") @db.VarChar(128)
  consentAt       DateTime @map("consent_at") @db.DateTime(0)
  createdAt       DateTime @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @map("updated_at") @db.DateTime(0)

  profile StudentPublicProfile @relation(fields: [profileId], references: [id])
  account StudentAccount       @relation(fields: [accountId], references: [id])

  @@index([profileId, createdAt], map: "idx_student_hire_enquiries_profile")
  @@index([accountId, createdAt], map: "idx_student_hire_enquiries_account")
  @@index([status, createdAt], map: "idx_student_hire_enquiries_status")
  @@index([enquirerEmail, createdAt], map: "idx_student_hire_enquiries_email")
  @@map("student_hire_enquiries")
}

model ShopProduct {
  id               BigInt    @id @default(autoincrement())
  productUuid      String    @unique(map: "uniq_tochukwu_shop_product_uuid") @map("product_uuid") @db.VarChar(64)
  slug             String    @unique(map: "uniq_tochukwu_shop_product_slug") @db.VarChar(190)
  title            String    @db.VarChar(255)
  subtitle         String?   @db.VarChar(255)
  shortDescription String    @map("short_description") @db.Text
  bodyContent      String?   @map("body_content") @db.LongText
  coverImageUrl    String?   @map("cover_image_url") @db.Text
  galleryJson      String?   @map("gallery_json") @db.LongText
  category         String    @default("workbooks") @db.VarChar(80)
  status           String    @default("draft") @db.VarChar(30)
  featured         Boolean   @default(false)
  seoTitle         String?   @map("seo_title") @db.VarChar(255)
  seoDescription   String?   @map("seo_description") @db.VarChar(500)
  faqJson          String?   @map("faq_json") @db.LongText
  sortOrder        Int       @default(0) @map("sort_order")
  publishedAt      DateTime? @map("published_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  variants   ShopProductVariant[]
  orderItems ShopOrderItem[]

  @@index([status, sortOrder], map: "idx_tochukwu_shop_product_status_sort")
  @@index([category, status], map: "idx_tochukwu_shop_product_category_status")
  @@map("tochukwu_shop_products")
}

model ShopProductVariant {
  id                     BigInt   @id @default(autoincrement())
  variantUuid            String   @unique(map: "uniq_tochukwu_shop_variant_uuid") @map("variant_uuid") @db.VarChar(64)
  productId              BigInt   @map("product_id")
  sku                    String   @unique(map: "uniq_tochukwu_shop_variant_sku") @db.VarChar(100)
  title                  String   @db.VarChar(160)
  fulfillmentType        String   @map("fulfillment_type") @db.VarChar(20)
  priceMinor             Int      @map("price_minor")
  currency               String   @default("NGN") @db.VarChar(12)
  compareAtMinor         Int?     @map("compare_at_minor")
  stockQuantity          Int?     @map("stock_quantity")
  inventoryPolicy        String   @default("deny") @map("inventory_policy") @db.VarChar(20)
  digitalAssetKey        String?  @map("digital_asset_key") @db.Text
  digitalFilename        String?  @map("digital_filename") @db.VarChar(255)
  cloudinaryPublicId     String?  @map("cloudinary_public_id") @db.Text
  cloudinaryResourceType String?  @map("cloudinary_resource_type") @db.VarChar(20)
  cloudinaryDeliveryType String?  @map("cloudinary_delivery_type") @db.VarChar(20)
  cloudinaryFormat       String?  @map("cloudinary_format") @db.VarChar(20)
  cloudinaryVersion      String?  @map("cloudinary_version") @db.VarChar(40)
  cloudinaryBytes        Int?     @map("cloudinary_bytes")
  weightGrams            Int?     @map("weight_grams")
  active                 Boolean  @default(true)
  sortOrder              Int      @default(0) @map("sort_order")
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  product      ShopProduct              @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices       ShopVariantPrice[]
  orderItems   ShopOrderItem[]
  entitlements ShopDigitalEntitlement[]

  @@index([productId, active, sortOrder], map: "idx_tochukwu_shop_variant_product_active")
  @@map("tochukwu_shop_product_variants")
}

model ShopVariantPrice {
  id          BigInt   @id @default(autoincrement())
  priceUuid   String   @unique(map: "uniq_tochukwu_shop_price_uuid") @map("price_uuid") @db.VarChar(64)
  variantId   BigInt   @map("variant_id")
  currency    String   @db.VarChar(12)
  amountMinor Int      @map("amount_minor")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  variant ShopProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency], map: "uniq_tochukwu_shop_price_variant_currency")
  @@index([currency, active], map: "idx_tochukwu_shop_price_currency_active")
  @@map("tochukwu_shop_variant_prices")
}

model ShopOrder {
  id                  BigInt    @id @default(autoincrement())
  orderUuid           String    @unique(map: "uniq_tochukwu_shop_order_uuid") @map("order_uuid") @db.VarChar(64)
  orderNumber         String    @unique(map: "uniq_tochukwu_shop_order_number") @map("order_number") @db.VarChar(40)
  studentAccountId    BigInt?   @map("student_account_id")
  customerName        String    @map("customer_name") @db.VarChar(180)
  customerEmail       String    @map("customer_email") @db.VarChar(190)
  customerPhone       String?   @map("customer_phone") @db.VarChar(40)
  customerCountry     String?   @map("customer_country") @db.VarChar(100)
  currency            String    @db.VarChar(12)
  subtotalMinor       Int       @map("subtotal_minor")
  discountMinor       Int       @default(0) @map("discount_minor")
  shippingMinor       Int       @default(0) @map("shipping_minor")
  taxMinor            Int       @default(0) @map("tax_minor")
  processingFeeMinor  Int       @default(0) @map("processing_fee_minor")
  totalMinor          Int       @map("total_minor")
  paymentProvider     String    @map("payment_provider") @db.VarChar(30)
  providerReference   String?   @unique(map: "uniq_tochukwu_shop_provider_reference") @map("provider_reference") @db.VarChar(190)
  providerOrderId     String?   @map("provider_order_id") @db.VarChar(190)
  paymentStatus       String    @default("pending") @map("payment_status") @db.VarChar(30)
  fulfillmentStatus   String    @default("unfulfilled") @map("fulfillment_status") @db.VarChar(30)
  shippingAddressJson String?   @map("shipping_address_json") @db.LongText
  paidAt              DateTime? @map("paid_at") @db.DateTime(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  studentAccount StudentAccount?          @relation(fields: [studentAccountId], references: [id], onDelete: SetNull)
  items          ShopOrderItem[]
  entitlements   ShopDigitalEntitlement[]
  shipment       ShopShipment?

  @@index([customerEmail, createdAt], map: "idx_tochukwu_shop_order_email_created")
  @@index([paymentStatus, createdAt], map: "idx_tochukwu_shop_order_payment_created")
  @@index([fulfillmentStatus, createdAt], map: "idx_tochukwu_shop_order_fulfillment_created")
  @@index([studentAccountId, createdAt], map: "idx_tochukwu_shop_order_student_created")
  @@map("tochukwu_shop_orders")
}

model ShopOrderItem {
  id                      BigInt   @id @default(autoincrement())
  itemUuid                String   @unique(map: "uniq_tochukwu_shop_order_item_uuid") @map("item_uuid") @db.VarChar(64)
  orderId                 BigInt   @map("order_id")
  productId               BigInt?  @map("product_id")
  variantId               BigInt?  @map("variant_id")
  productTitleSnapshot    String   @map("product_title_snapshot") @db.VarChar(255)
  productSlugSnapshot     String   @map("product_slug_snapshot") @db.VarChar(190)
  variantTitleSnapshot    String   @map("variant_title_snapshot") @db.VarChar(160)
  skuSnapshot             String   @map("sku_snapshot") @db.VarChar(100)
  fulfillmentTypeSnapshot String   @map("fulfillment_type_snapshot") @db.VarChar(20)
  unitPriceMinor          Int      @map("unit_price_minor")
  quantity                Int      @default(1)
  lineTotalMinor          Int      @map("line_total_minor")
  createdAt               DateTime @default(now()) @map("created_at") @db.DateTime(0)

  order        ShopOrder                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      ShopProduct?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ShopProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  entitlements ShopDigitalEntitlement[]

  @@index([orderId], map: "idx_tochukwu_shop_order_item_order")
  @@index([productId], map: "idx_tochukwu_shop_order_item_product")
  @@index([variantId], map: "idx_tochukwu_shop_order_item_variant")
  @@map("tochukwu_shop_order_items")
}

model ShopDigitalEntitlement {
  id              BigInt    @id @default(autoincrement())
  entitlementUuid String    @unique(map: "uniq_tochukwu_shop_entitlement_uuid") @map("entitlement_uuid") @db.VarChar(64)
  orderId         BigInt    @map("order_id")
  orderItemId     BigInt    @map("order_item_id")
  variantId       BigInt?   @map("variant_id")
  recipientEmail  String    @map("recipient_email") @db.VarChar(190)
  status          String    @default("active") @db.VarChar(20)
  downloadCount   Int       @default(0) @map("download_count")
  lastDownloadAt  DateTime? @map("last_download_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  order     ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem ShopOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant   ShopProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, recipientEmail], map: "uniq_tochukwu_shop_entitlement_item_email")
  @@index([recipientEmail, status], map: "idx_tochukwu_shop_entitlement_email_status")
  @@map("tochukwu_shop_digital_entitlements")
}

model ShopShipment {
  id             BigInt    @id @default(autoincrement())
  shipmentUuid   String    @unique(map: "uniq_tochukwu_shop_shipment_uuid") @map("shipment_uuid") @db.VarChar(64)
  orderId        BigInt    @unique(map: "uniq_tochukwu_shop_shipment_order") @map("order_id")
  status         String    @default("processing") @db.VarChar(30)
  carrier        String?   @db.VarChar(120)
  service        String?   @db.VarChar(120)
  trackingNumber String?   @map("tracking_number") @db.VarChar(190)
  trackingUrl    String?   @map("tracking_url") @db.Text
  adminNotes     String?   @map("admin_notes") @db.Text
  shippedAt      DateTime? @map("shipped_at") @db.DateTime(0)
  deliveredAt    DateTime? @map("delivered_at") @db.DateTime(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "idx_tochukwu_shop_shipment_status_created")
  @@map("tochukwu_shop_shipments")
}

model StudentSession {
  id           BigInt    @id @default(autoincrement())
  sessionUuid  String    @unique(map: "uniq_student_session_uuid") @map("session_uuid") @db.VarChar(64)
  accountId    BigInt    @map("account_id")
  tokenHash    String    @unique(map: "uniq_student_session_token") @map("token_hash") @db.VarChar(128)
  deviceHash   String?   @map("device_hash") @db.VarChar(128)
  deviceIdHint String?   @map("device_id_hint") @db.VarChar(190)
  ipHash       String?   @map("ip_hash") @db.VarChar(128)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(0)
  createdAt    DateTime  @map("created_at") @db.DateTime(0)
  lastSeenAt   DateTime? @map("last_seen_at") @db.DateTime(0)

  account StudentAccount @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "idx_student_session_account")
  @@index([expiresAt], map: "idx_student_session_expiry")
  @@index([deviceHash], map: "idx_student_session_device")
  @@map("student_sessions")
}

