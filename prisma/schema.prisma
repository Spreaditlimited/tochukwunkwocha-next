  adminUuid   String   @map("admin_uuid") @db.VarChar(64)
  format      String   @db.VarChar(12)
  filtersJson String?  @map("filters_json") @db.LongText
  rowCount    Int      @default(0) @map("row_count")
  createdAt   DateTime @map("created_at") @db.DateTime(0)

  @@index([adminUuid, createdAt], map: "idx_tochukwu_financial_export_admin")
